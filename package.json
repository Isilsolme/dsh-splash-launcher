{
  "name": "dsh-splash-launcher",
  "version": "1.2.0",
  "description": "DSH Windows one-click launcher with a stroke-by-stroke startup animation: ships a self-contained DSH-GUI.exe and registers the desktop_launch agent tool.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "prepublishOnly": "build.cmd"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "DSH-GUI.exe",
    "splash.html",
    "deepseek-wordmark.svg",
    "whale.png",
    "whale-anim.svg",
    "icons/whale-black.ico",
    "README.md",
    "LICENSE"
  ],
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Isilsolme/dsh-splash-launcher.git"
  }
}
